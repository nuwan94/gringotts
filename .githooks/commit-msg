#!/usr/bin/env bash
# Enforces Conventional Commits on the subject line. See CONTRIBUTING.md.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

subject=$(grep -v '^#' "$1" | head -n 1)

# Messages git generates itself.
if [[ "$subject" =~ ^(Merge|Revert\ \"|fixup!|squash!|amend!) ]]; then
  exit 0
fi

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^(${types})(\([a-z0-9-]+\))?!?: [^ ].*[^.]$"

if [[ ! "$subject" =~ $pattern ]]; then
  cat >&2 <<EOF
✗ Commit subject is not a Conventional Commit:

    $subject

  Expected:  <type>(<scope>): <subject>
  Types:     ${types//|/, }
  Example:   feat(ledger): reject unbalanced journal entries

  See CONTRIBUTING.md.
EOF
  exit 1
fi

if (( ${#subject} > 72 )); then
  echo "✗ Commit subject is ${#subject} characters; keep it to 72 or fewer." >&2
  exit 1
fi
